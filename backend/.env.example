RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=10 m
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=1 h
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW=15 m
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_UPLOAD_WINDOW=10 m

