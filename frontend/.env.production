# In production the API is served from the same origin as the storefront:
# Vercel rewrites /api/* to the Render backend (see vercel.json). Keeping the
# cookie first-party is what makes the refresh session survive reloads on
# browsers that block third-party cookies.
VITE_API_URL=/api

# WebSockets are not proxied by Vercel rewrites, so the admin socket still
# talks to Render directly. It authenticates with the in-memory access token
# instead of the refresh cookie.
VITE_SOCKET_URL=https://classy-shop-backend.onrender.com
